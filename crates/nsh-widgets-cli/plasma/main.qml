// A KDE Plasma widget for one nsh-widgets kind. Generated by `nsh-widgets plasmoid`; the renderer is
// NshNode.qml. It reads the kind through `nsh-widgets show --format ir` every two seconds and runs
// button presses through `nsh-widgets apply`, so the app's store stays the only source of data.
@IMPORTS@
import QtQuick 2.15
import QtQuick.Layouts 1.15

@ROOT@ {
    id: main
    property var snap: null
    property var vals: ({})
    property real now: Date.now()
    property int tick: 0
    property string last: ""
    readonly property bool dark: Kirigami.Theme.backgroundColor.hslLightness < 0.5
    readonly property string cmd: "@CMD@"
    readonly property string source: "@SOURCE@"

    @BACKGROUND@
    @PREFERRED@

    function refresh() {
        // The executable engine runs a source once; a trailing shell comment makes each read a new source.
        exec.connectSource(cmd + " show @KIND@ " + source + " --format ir #" + (++tick))
    }
    function run(action) {
        if (action.indexOf("open:") === 0) { Qt.openUrlExternally(action.substring(5)); return }
        exec.connectSource(cmd + " apply @KIND@ " + action + " " + source + " #" + (++tick))
    }

    @DATASOURCE@ {
        id: exec
        engine: "executable"
        connectedSources: []
        onNewData: function (sourceName, data) {
            disconnectSource(sourceName)
            if (sourceName.indexOf(" show ") < 0) { main.refresh(); return }
            try {
                var j = JSON.parse(data["stdout"])
                // Rebuild the tree only for a real change: a rebuild puts a scrolled list back at its top.
                var key = JSON.stringify([j.snapshot, j.data])
                if (key === main.last) return
                main.last = key
                main.snap = j.snapshot
                main.vals = j.data
            } catch (e) {}
        }
    }

    Timer {
        interval: 1000; running: true; repeat: true; triggeredOnStart: true
        onTriggered: { main.now = Date.now(); if (main.tick % 2 === 0) main.refresh(); else main.tick++ }
    }

    @FULL@: Rectangle {
        id: frame
        Layout.minimumWidth: 160
        Layout.minimumHeight: tree.item ? Math.max(120, tree.item.implicitHeight + pad[0] + pad[2]) : 160
        Layout.preferredWidth: 340
        Layout.preferredHeight: tree.item ? Math.max(120, tree.item.implicitHeight + pad[0] + pad[2]) : 200
        readonly property var st: main.snap && main.snap.root && main.snap.root.style ? main.snap.root.style : ({})
        readonly property var pad: st.pad || [16, 16, 16, 16]
        radius: 16
        color: st.gradient ? "transparent" : (st.bg ? (main.dark ? st.bg[1] : st.bg[0]) : Kirigami.Theme.backgroundColor)
        gradient: st.gradient ? g : null
        Gradient {
            id: g
            orientation: frame.st.gradient && frame.st.gradient.dir === "r" ? Gradient.Horizontal : Gradient.Vertical
            GradientStop { position: 0; color: frame.st.gradient ? (main.dark ? frame.st.gradient.from[1] : frame.st.gradient.from[0]) : "transparent" }
            GradientStop { position: 1; color: frame.st.gradient ? (main.dark ? frame.st.gradient.to[1] : frame.st.gradient.to[0]) : "transparent" }
        }
        Text {
            visible: !main.snap
            anchors.centerIn: parent
            text: "Open the app to set up this widget"
            color: Kirigami.Theme.textColor
        }
        Loader {
            id: tree
            anchors.fill: parent
            anchors.topMargin: parent.pad[0]; anchors.rightMargin: parent.pad[1]
            anchors.bottomMargin: parent.pad[2]; anchors.leftMargin: parent.pad[3]
            readonly property var rootNode: main.snap ? main.snap.root : null
            onRootNodeChanged: load()
            Connections { target: main; function onValsChanged() { tree.load() } function onDarkChanged() { tree.load() } }
            function load() {
                if (!rootNode) return
                var r = JSON.parse(JSON.stringify(rootNode))
                if (r.style) { delete r.style.bg; delete r.style.gradient; delete r.style.pad; delete r.style.radius }
                setSource("NshNode.qml", { n: r, vals: main.vals, dark: main.dark, now: main.now, family: width < 200 ? "small" : width < 450 ? "medium" : "large",
                    fontFamily: main.snap.font || "", run: main.run })
            }
            onLoaded: item.now = Qt.binding(function () { return main.now })
        }
    }

    @COMPACT@: Loader {
        // In a panel: the kind's lock-screen tree, as the iOS lock screen and Waybar show it.
        Layout.minimumWidth: item ? item.implicitWidth : 24
        readonly property var node: main.snap ? (main.snap.accessory || main.snap.root) : null
        onNodeChanged: if (node) setSource("NshNode.qml", { n: node, vals: main.vals, dark: main.dark, now: main.now, family: "inline", run: main.run })
        onLoaded: { item.now = Qt.binding(function () { return main.now }); item.vals = Qt.binding(function () { return main.vals }) }
        MouseArea { anchors.fill: parent; onClicked: @EXPANDED@ = !@EXPANDED@ }
    }
}
